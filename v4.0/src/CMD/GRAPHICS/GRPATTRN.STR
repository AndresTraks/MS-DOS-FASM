STRUC TAB_ENTRY TAB_OFFSET_=0, TAB_COPY_=0, TAB_SIZE_=0, BOX_W_PAT_=0, BOX_H_PAT_=0, NB_INT_=0
{
			   ;   WHAT TABLE OF PATTERNS TO USE			;AN000;
  .TAB_OFFSET DW  TAB_OFFSET_ ; ADDRESS OF THE PATTERN TABLE			;AN000;
  .TAB_COPY   DW  TAB_COPY_ ; ADDRESS OF PATTERN TABLE COPY IN SHARED DATA	;AN000;
  .TAB_SIZE   DW  TAB_SIZE_ ; SIZE OF THE PATTERN TABLE				;AN000;
  .BOX_W_PAT  DB  BOX_W_PAT_ ; BOX WIDTH	FOR PATTERNS IN THIS TABLE		;AN000;
  .BOX_H_PAT  DB  BOX_H_PAT_ ; BOX HEIGHT FOR PATTERNS IN THIS TABLE		;AN000;
  .NB_INT     DB  NB_INT_ ; NUMBER OF INTENSITIES IN THIS TABLE		;AN000;
}
match =TAB_ENTRY_LAID_OUT, TAB_ENTRY_LAID_OUT
{
    TAB_ENTRY_LAID_OUT equ 1
    virtual at 0
      TAB_ENTRY TAB_ENTRY 0, 0, 0, 0, 0, 0
      sizeof.TAB_ENTRY = $ - TAB_ENTRY
    end virtual
}
