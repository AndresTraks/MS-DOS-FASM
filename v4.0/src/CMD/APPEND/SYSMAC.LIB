;
; SYSTEM MACROS
;
; DISPLAY TEXT ON SCREEN
;
macro DISP [TEXT]
{
;   IFNB <SEGM>
;     IFDIF <SEGM>,<DS>
;	PUSH	DS
;	MOV	AX,SEGM
;	MOV	DS,AX
;     ENDIF
;   ENDIF
;   IFNB <TEXT>
;	LEA	DX,TEXT
;   ENDIF
;	DOS	DSTR
;   IFNB <SEGM>
;     IFDIF <SEGM>,<DS>
;	POP	DS
;     ENDIF
;   ENDIF
}
;
macro DMSG MSG
{
	match any$, MSG \{
	LEA	DX,[MSG]
	\}
	DISP
}
;
macro DCHAR CHAR
{
	PUSH	DX
	match any$, CHAR \{
	MOV	DL,CHAR 			; SET CHARACTER
	\}
	match , CHAR \{
	MOV	DL,AL
	\}
	DOS	DO
	POP	DX
}
;
; CLEAR  SCREEN
;
macro CLEAR 
{
	MOV	CX,00H*256+00H			; ROW=00, COL=00
	MOV	DX,24H*256+79H			; ROW=24, COL=79
	MOV	BH,07H				; NORMAL ATTRIBUTE
	MOV	AX,06H*256+00H			; CLEAR WHOLE SCREEN
	INT	10H
}
;
macro POS ROW,COL,PAGE
{
	match any$, ROW \{
	MOV	DX,ROW*256+COL			; SET ROW AND COLUMN
	\}
	match any$, PAGE \{
	MOV	BH,PAGE 			; SET PAGE
	\}
	match , PAGE \{
	MOV	BH,0
	\}
	MOV	AH,02H				; POSTIION CURSOR
	INT	10H
}
;
macro DEFMSG ID,T1,T2,T3,T4,T5,T6,T7,T8,T9,T10
{
	 match any$, ID \{
label ID byte      ; DEFINE ESSAGE
	 \}
	 match any$, T1 \{
	 DB	 T1
	 \}
	 match any$, T2 \{
	 DB	 T2
	 \}
	 match any$, T3 \{
	 DB	 T3
	 \}
	 match any$, T4 \{
	 DB	 T4
	 \}
	 match any$, T5 \{
	 DB	 T5
	 \}
	 match any$, T6 \{
	 DB	 T6
	 \}
	 match any$, T7 \{
	 DB	 T7
	 \}
	 match any$, T8 \{
	 DB	 T8
	 \}
	 match any$, T9 \{
	 DB	 T9
	 \}
	 match any$, T10 \{
	 DB	 T10
	 \}
	 DB	 '$'
}
;
macro MOVE TO,LEN,FROM
{
	 match any$, TO \{
	 LEA	 DI,[TO]  ; SET DESTINATION
	 \}
	 match any$, LEN \{
	 MOV	 CX,LEN 			; SET LENGTH
	 \}
	 match any$, FROM \{
	 LEA	 SI,[FROM] ; SET SOURCE
	 \}
     REP MOVSb
}
macro MOVEZ TO,FROM
{
	 match any$, TO \{
	 LEA	DI,[TO]  ; SET DESTINATION
	 \}
	 match any$, FROM \{
	 LEA	SI,[FROM]  ; SET SOURCE
	 \}
	 CALL	MOVZ$
}
;
macro SCAN TO,LEN,VALUE,TYPE
{
	 match any$, TO \{
	 LEA	 DI,[TO]  ; SET DESTINATION
	 \}
	 match any$, LEN \{
	 MOV	 CX,LEN 			; SET LENGTH
	 \}
	 match any$, VALUE \{
	 MOV	 AL,VALUE			; SET SOURCE
	 \}
	 match , TYPE \{
   REPZ  SCASB
	 \}
	 match =EQ, TYPE \{
   REPZ  SCASB
	 \}
	 match =Z, TYPE \{
   REPZ  SCASB
	 \}
	 match =NE, TYPE \{
   REPNZ SCASB
	 \}
	 match =NZ, TYPE \{
   REPNZ SCASB
	 \}
}
;
macro FILL TO,LEN,VALUE
{
	 PUSH	 DI
	 PUSH	 CX
	 match any$, TO \{
	 LEA	 DI,[TO]  ; SET DESTINATION
	 \}
	 match any$, LEN \{
	 MOV	 CX,LEN 			; SET LENGTH
	 \}
	 match any$, VALUE \{
	 MOV	 AL,VALUE			; SET SOURCE
	 \}
     REP STOSb
	 POP	 CX
	 POP	 DI
}
;
macro COMP TO,LEN,FROM
{
	 match any$, TO \{
	 LEA	 DI,[TO]  ; SET DESTINATION
	 \}
	 match any$, LEN \{
	 MOV	 CX,LEN 			; SET LENGTH
	 \}
	 match any$, FROM \{
	 LEA	 SI,[FROM] ; SET SOURCE
	 \}
    REPE CMPSb
}
macro COMPZ TO,FROM
{
	 match any$, TO \{
	 LEA	 DI,[TO]  ; SET DESTINATION
	 \}
	 match any$, FROM \{
	 LEA	 SI,[FROM] ; SET SOURCE
	 \}
	 CALL	CMPZ$
}
;
macro XCHGS O1,O2
{
	 PUSH	 O1
	 PUSH	 O2
	 POP	 O1
	 POP	 O2
}
;
macro JUMP COND,TARGET
{
	 local	 LAB
	 match , COND \{
	JMP    TARGET
	 \}
	 match =A, COND \{
	JNA    LAB
	JMP    TARGET
LAB:
	 \}
	 match =NBE, COND \{
	JBE    LAB
	JMP    TARGET
LAB:
	 \}
	 match =AE, COND \{
	JNAE   LAB
	JMP    TARGET
LAB:
	 \}
	 match =NB, COND \{
	JB     LAB
	JMP    TARGET
LAB:
	 \}
	 match =B, COND \{
	JNB    LAB
	JMP    TARGET
LAB:
	 \}
	 match =NAE, COND \{
	JAE    LAB
	JMP    TARGET
LAB:
	 \}
	 match =C, COND \{
	JNC    LAB
	JMP    TARGET
LAB:
	 \}
	 match =BE, COND \{
	JNBE   LAB
	JMP    TARGET
LAB:
	 \}
	 match =NA, COND \{
	JA     LAB
	JMP    TARGET
LAB:
	 \}
	 match =CXZ, COND \{
	OR     CX,CX
	JNZ    LAB
	JMP    TARGET
LAB:
	 \}
	 match =E, COND \{
	JNE    LAB
	JMP    TARGET
LAB:
	 \}
	 match =Z, COND \{
	JNZ    LAB
	JMP    TARGET
LAB:
	 \}
	 match =G, COND \{
	JNG    LAB
	JMP    TARGET
LAB:
	 \}
	 match =NLE, COND \{
	JLE    LAB
	JMP    TARGET
LAB:
	 \}
	 match =GE, COND \{
	JNGE   LAB
	JMP    TARGET
LAB:
	 \}
	 match =NL, COND \{
	JL     LAB
	JMP    TARGET
LAB:
	 \}
	 match =L, COND \{
	JNL    LAB
	JMP    TARGET
LAB:
	 \}
	 match =NGE, COND \{
	JGE    LAB
	JMP    TARGET
LAB:
	 \}
	 match =LE, COND \{
	JNLE   LAB
	JMP    TARGET
LAB:
	 \}
	 match =NG, COND \{
	JG     LAB
	JMP    TARGET
LAB:
	 \}
	 match =NC, COND \{
	JC     LAB
	JMP    TARGET
LAB:
	 \}
	 match =NE, COND \{
	JE     LAB
	JMP    TARGET
LAB:
	 \}
	 match =NZ, COND \{
	JZ     LAB
	JMP    TARGET
LAB:
	 \}
	 match =NO, COND \{
	JO     LAB
	JMP    TARGET
LAB:
	 \}
	 match =NP, COND \{
	JP     LAB
	JMP    TARGET
LAB:
	 \}
	 match =PO, COND \{
	JPE    LAB
	JMP    TARGET
LAB:
	 \}
	 match =NS, COND \{
	JS     LAB
	JMP    TARGET
LAB:
	 \}
	 match =O, COND \{
	JNO    LAB
	JMP    TARGET
LAB:
	 \}
	 match =P, COND \{
	JNP    LAB
	JMP    TARGET
LAB:
	 \}
	 match =PE, COND \{
	JPO    LAB
	JMP    TARGET
LAB:
	 \}
	 match =S, COND \{
	JNS    LAB
	JMP    TARGET
LAB:
	 \}
}
;
