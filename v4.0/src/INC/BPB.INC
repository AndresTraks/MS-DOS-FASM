; BIOS PARAMETER BLOCK DEFINITION
; THIS STRUCTURE IS USED TO BUILD A FULL DPB

STRUC BPBLOCK
{
.BPSECSZ DW	0			; SIZE IN BYTES OF PHYSICAL SECTOR
.BPCLUS	DB	0			; SECTORS/ALLOC UNIT
.BPRES	DW	0			; NUMBER OF RESERVED SECTORS
.BPFTCNT DB	0			; NUMBER OF FATS
.BPDRCNT DW	0			; NUMBER OF DIRECTORY ENTRIES
.BPSCCNT DW	0			; TOTAL NUMBER OF SECTORS
.BPMEDIA DB	0			; MEDIA DESCRIPTOR BYTE
.BPFTSEC DW	0			; NUMBER OF SECTORS TAKEN UP BY ONE FAT
}
match =BPBLOCK_LAID_OUT, BPBLOCK_LAID_OUT
{
    BPBLOCK_LAID_OUT equ 1
    virtual at 0
      BPBLOCK BPBLOCK
      sizeof.BPBLOCK = $ - BPBLOCK
    end virtual
}

STRUC A_BPB
{
.BPB_BYTESPERSECTOR	DW	0
.BPB_SECTORSPERCLUSTER	DB	0
.BPB_RESERVEDSECTORS	DW	0
.BPB_NUMBEROFFATS	DB	0
.BPB_ROOTENTRIES 	DW	0
.BPB_TOTALSECTORS	DW	0
.BPB_MEDIADESCRIPTOR	DB	0
.BPB_SECTORSPERFAT	DW	0
.BPB_SECTORSPERTRACK	DW	0
.BPB_HEADS		DW	0
.BPB_HIDDENSECTORS	DW	0
			DW	0
.BPB_BIGTOTALSECTORS	DW	0
			DW	0
			DB	6 dup(0)
}
match =A_BPB_LAID_OUT, A_BPB_LAID_OUT
{
    A_BPB_LAID_OUT equ 1
    virtual at 0
      A_BPB A_BPB
      sizeof.A_BPB = $ - A_BPB
    end virtual
}
