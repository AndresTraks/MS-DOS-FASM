; BIOS PARAMETER BLOCK DEFINITION
; THIS STRUCTURE IS USED TO BUILD A FULL DPB

STRUC BPBLOCK
{
.BPSECSZ DW	0			; SIZE IN BYTES OF PHYSICAL SECTOR
.BPCLUS	DB	0			; SECTORS/ALLOC UNIT
.BPRES	DW	0			; NUMBER OF RESERVED SECTORS
.BPFTCNT DB	0			; NUMBER OF FATS
.BPDRCNT DW	0			; NUMBER OF DIRECTORY ENTRIES
.BPSCCNT DW	0			; TOTAL NUMBER OF SECTORS
.BPMEDIA DB	0			; MEDIA DESCRIPTOR BYTE
.BPFTSEC DW	0			; NUMBER OF SECTORS TAKEN UP BY ONE FAT
}
match =BPBLOCK_LAID_OUT, BPBLOCK_LAID_OUT
{
    BPBLOCK_LAID_OUT equ 1
    virtual at 0
      BPBLOCK BPBLOCK
      sizeof.BPBLOCK = $ - BPBLOCK
    end virtual
}

STRUC A_BPB BPB_BYTESPERSECTOR_=0, BPB_SECTORSPERCLUSTER_=0, BPB_RESERVEDSECTORS_=0, BPB_NUMBEROFFATS_=0, BPB_ROOTENTRIES_=0, BPB_TOTALSECTORS_=0, BPB_MEDIADESCRIPTOR_=0, BPB_SECTORSPERFAT_=0, BPB_SECTORSPERTRACK_=0, BPB_HEADS_=0, BPB_HIDDENSECTORS_=0, BPB_HIDDENSECTORS_HIGH_=0, BPB_BIGTOTALSECTORS_=0, BPB_BIGTOTALSECTORS_HIGH_=0
{
.BPB_BYTESPERSECTOR	DW	BPB_BYTESPERSECTOR_
.BPB_SECTORSPERCLUSTER	DB	BPB_SECTORSPERCLUSTER_
.BPB_RESERVEDSECTORS	DW	BPB_RESERVEDSECTORS_
.BPB_NUMBEROFFATS	DB	BPB_NUMBEROFFATS_
.BPB_ROOTENTRIES 	DW	BPB_ROOTENTRIES_
.BPB_TOTALSECTORS	DW	BPB_TOTALSECTORS_
.BPB_MEDIADESCRIPTOR	DB	BPB_MEDIADESCRIPTOR_
.BPB_SECTORSPERFAT	DW	BPB_SECTORSPERFAT_
.BPB_SECTORSPERTRACK	DW	BPB_SECTORSPERTRACK_
.BPB_HEADS		DW	BPB_HEADS_
.BPB_HIDDENSECTORS	DW	BPB_HIDDENSECTORS_
			DW	BPB_HIDDENSECTORS_HIGH_
.BPB_BIGTOTALSECTORS	DW	BPB_BIGTOTALSECTORS_
			DW	BPB_BIGTOTALSECTORS_HIGH_
			DB	6 dup(0)
}
match =A_BPB_LAID_OUT, A_BPB_LAID_OUT
{
    A_BPB_LAID_OUT equ 1
    virtual at 0
      A_BPB A_BPB
      sizeof.A_BPB = $ - A_BPB
    end virtual
}
