; Some information about creating instructions

; MODIFIER BYTE VALUES

;       MOD    REG/OPX    R/M
;       ---    -------    ---
;        11      111      111

; EAX  AX  AL    000             DISP0   00
; ECX  CX  CL    001             DISPB   01
; EDX  DX  DL    010             DISPW   10
; EBX  BX  BL    011             DISPR   11
; ESP  SP  AH    100
; EBP  BP  CH    101
; ESI  SI  DH    110
; EDI  DI  BH    111

; ES:0
; CS:1
; SS:2
; DS:3
; FS:4
; GS:5


; OPX FIELD VALUES

;  00F-000 OPCODE VALUES                00F-001 OPCODE VALUES
;  ---------------------                ---------------------

;    SLDT    000                          SGDT    000
;    STR     001                          SIDT    001
;    LLDT    010                          LIDT    010
;    LTR     011                          LGDT    011
;    VERR    100                          SMSW    100
;    VERW    101                          ?       101
;    ?       110                          LMSW    110
;    ?       111                          ?       111


PAGE

; Macros to move to and from the 80386 system registers and to and from the
; new segment registers FS and GS.


;  CMOV - Move to and From Control Registers
;
;  Examples:
;
;       CMOV    CRx,EREG
;       CMOV    EREG,CRx
;

macro CMOV REG1,REG2
{

        _CREGFD = 0
        _CRCNT = 0
        irp TREG, CR3,CR2,CR1,CR0 \{
         define idn$indeins1 idn$no
         match =TREG, REG1 \\{ define idn$indeins1 idn$yes \\}
         match =idn$yes, idn$indeins1 \\{
          _CREGFD = 1
          _CRCNT = 0
         \\}
         match =idn$no, idn$indeins1 \\{
          _CRCNT = _CRCNT + 1
         \\}
        \}
        if (_CREGFD-1) = 0
         F_DREG <REG2>
         IF _DREGNUM < 8
           DB    0FH
           DB    22H
           DB    0C0H + _CRCNT*8 + _DREGNUM
         ELSE
          SYNTAX ERROR - EXTENDED REGISTER EXPECTED
         end if
        ELSE
         _CREGFD = 0
         _CRCNT = 0
         irp TREG, CR3,CR2,CR1,CR0 \{
          define idn$indeins2 idn$no
          match =TREG, REG2 \\{ define idn$indeins2 idn$yes \\}
          match =idn$yes, idn$indeins2 \\{
           _CREGFD = 1
           _CRCNT = 0
          \\}
          match =idn$no, idn$indeins2 \\{
           _CRCNT = _CRCNT + 1
          \\}
         \}
         if (_CREGFD-1) = 0
          F_DREG <REG1>
          IF _DREGNUM < 8
           DB    0FH
           DB    20H
           DB    0C0H + _CRCNT*8 + _DREGNUM
          ELSE
           SYNTAX ERROR - EXTENDED REGISTER EXPECTED
          end if
         ELSE
          SYNTAX ERROR - CONTROL REGISTER EXPECTED
         end if
        end if
}


;  DMOV - Move to and From Debug Registers
;
;  Examples:
;
;       DMOV    DRx,EREG
;       DMOV    EREG,DRx
;

macro DMOV REG1,REG2
{

        _DREGFD = 0
        _DRCNT = 0
        irp TREG, DR7,DR6,DRX,DRX,DR3,DR2,DR1,DR0 \{
         define idn$indeins3 idn$no
         match =TREG, REG1 \\{ define idn$indeins3 idn$yes \\}
         match =idn$yes, idn$indeins3 \\{
          _DREGFD = 1
          _DRCNT = 0
         \\}
         match =idn$no, idn$indeins3 \\{
          _DRCNT = _DRCNT + 1
         \\}
        \}
        if (_DREGFD-1) = 0
         F_DREG <REG2>
         IF _DREGNUM < 8
          DB    0FH
          DB    23H
          DB    0C0H + _DRCNT*8 + _DREGNUM
         ELSE
          SYNTAX ERROR - EXTENDED REGISTER EXPECTED
         end if
        ELSE
         _DREGFD = 0
         _DRCNT = 0
         irp TREG, DR7,DR6,DRX,DRX,DR3,DR2,DR1,DR0 \{
          define idn$indeins4 idn$no
          match =TREG, REG2 \\{ define idn$indeins4 idn$yes \\}
          match =idn$yes, idn$indeins4 \\{
           _DREGFD = 1
           _DRCNT = 0
          \\}
          match =idn$no, idn$indeins4 \\{
           _DRCNT = _DRCNT + 1
          \\}
         \}
         if (_DREGFD-1) = 0
          F_DREG <REG1>
          IF _DREGNUM < 8
           DB    0FH
           DB    21H
           DB    0C0H + _DRCNT*8 + _DREGNUM
          ELSE
           SYNTAX ERROR - EXTENDED REGISTER EXPECTED
          end if
         ELSE
          SYNTAX ERROR - DEBUG REGISTER EXPECTED
         end if
        end if
}

;  TMOV - Move to and From Test Registers
;
;  Examples:
;
;       TMOV    TRx,EREG
;       TMOV    EREG,TRx
;

macro TMOV REG1,REG2
{

        _TREGFD = 0
        _TRCNT = 0
        irp TREG, TR7,TR6 \{
         define idn$indeins5 idn$no
         match =TREG, REG1 \\{ define idn$indeins5 idn$yes \\}
         match =idn$yes, idn$indeins5 \\{
          _TREGFD = 1
          _TRCNT = 0
         \\}
         match =idn$no, idn$indeins5 \\{
          _TRCNT = _TRCNT + 1
         \\}
        \}
        _TRCNT = _TRCNT + 6
        if (_TREGFD-1) = 0
         F_DREG <REG2>
         IF _DREGNUM < 8
          DB    0FH
          DB    26H
          DB    0C0H + _TRCNT*8 + _DREGNUM
         ELSE
          SYNTAX ERROR - EXTENDED REGISTER EXPECTED
         end if
        ELSE
         _TREGFD = 0
         _TRCNT = 0
         irp TREG, TR7,TR6 \{
          define idn$indeins6 idn$no
          match =TREG, REG2 \\{ define idn$indeins6 idn$yes \\}
          match =idn$yes, idn$indeins6 \\{
           _TREGFD = 1
           _TRCNT = 0
          \\}
          match =idn$no, idn$indeins6 \\{
           _TRCNT = _TRCNT + 1
          \\}
         \}
         _TRCNT = _TRCNT + 6
         if (_TREGFD-1) = 0
          F_DREG <REG1>
          IF _DREGNUM < 8
           DB    0FH
           DB    24H
           DB    0C0H + _TRCNT*8 + _DREGNUM
          ELSE
           SYNTAX ERROR - EXTENDED REGISTER EXPECTED
          end if
         ELSE
          SYNTAX ERROR - TEST REGISTER EXPECTED
         end if
        end if
}

;  SMOV - Move to/from FS/GS segment registers from/to general registers
;
;  Examples:
;
;       SMOV    SReg, REG16
;       SMOV    REG16, SReg
;

macro SMOV REG1,REG2
{
        _SREGNUM = 8
        _SREG1 = 1
        define idn$indeins7 idn$no
        match =FS, REG1 \{ define idn$indeins7 idn$yes \}
        match =idn$yes, idn$indeins7 \{
         _SREGNUM = 4
        \}
        match =idn$no, idn$indeins7 \{
         match =FS, REG1 \\{
          _SREGNUM = 4
         \\}
        \}
        IF _SREGNUM > 7
         define idn$indeins8 idn$no
         match =GS, REG1 \{ define idn$indeins8 idn$yes \}
         match =idn$yes, idn$indeins8 \{
          _SREGNUM = 5
         \}
         match =idn$no, idn$indeins8 \{
          match =GS, REG1 \\{
           _SREGNUM = 5
          \\}
         \}
        end if
        IF _SREGNUM > 7
         _SREG1 = 0
         define idn$indeins9 idn$no
         match =FS, REG2 \{ define idn$indeins9 idn$yes \}
         match =idn$yes, idn$indeins9 \{
          _SREGNUM = 4
         \}
         match =idn$no, idn$indeins9 \{
          match =FS, REG2 \\{
           _SREGNUM = 4
          \\}
         \}
         IF _SREGNUM > 7
          define idn$indeins10 idn$no
          match =GS, REG2 \{ define idn$indeins10 idn$yes \}
          match =idn$yes, idn$indeins10 \{
           _SREGNUM = 5
          \}
          match =idn$no, idn$indeins10 \{
           match =GS, REG2 \\{
            _SREGNUM = 5
           \\}
          \}
         end if
        end if
        IF _SREGNUM > 7
         SYNTAX ERROR - FS OR GS SEGMENT REGISTER EXPECTED
        ELSE
         IF _SREG1 = 1
          DB    8EH
          F_WREG <REG2>
         ELSE
          DB    8CH
          F_WREG <REG1>
         end if
         IF _WREGNUM > 7
; MASM read a type name in an expression as the number of bytes it
; takes up, so BYTE on its own is 1 and WORD is 2.
          SYNTAX ERROR -  2 REGISTER EXPECTED
         ELSE
          DB    0C0H + _SREGNUM*8 + _WREGNUM
         end if
        end if
}

macro F_MOD TYPE,DISP1,DISP2
{
        _DISP = 2
;;                         1      0
        irp _TEST_, DISP32, DISP8 \{
         define idn$indeins11 idn$no
         match =_TEST_, TYPE \\{ define idn$indeins11 idn$yes \\}
         match =idn$yes, idn$indeins11 \\{
          _DISP = 0
         \\}
         match =idn$no, idn$indeins11 \\{
          _DISP = _DISP + 1
         \\}
        \}
        if ~ (_DISP < 2)
;;                          1      0
         irp _TEST_, DISP32, DISP8 \{
          define idn$indeins12 idn$no
          match =_TEST_, TYPE \\{ define idn$indeins12 idn$yes \\}
          match =idn$yes, idn$indeins12 \\{
           _DISP = 0
          \\}
          match =idn$no, idn$indeins12 \\{
           _DISP = _DISP + 1
          \\}
         \}
        end if
        IF _DISP < 2
         match , DISP1 \{
          SYNTAX ERROR - IMMEDIATE OPERAND EXPECTED
         \}
         match any$, DISP1 \{
          if (_DISP-1) = 0
           _MOD = 2
          ELSE
           _MOD = 1
          end if
         \}
        ELSE
         _MOD = 0
        end if
}

macro MK_DISP P3,P4
{
        if (_DISP) = 0
            DB     P3
        ELSE
            DW     P3
         match any$, P4 \{
          define idn$indeins13 idn$yes
          match =IMMD, P4 \\{ define idn$indeins13 idn$no \\}
          match =idn$yes, idn$indeins13 \\{
            DW     P4
          \\}
         \}
         match , P4 \{
            DW     0H
         \}
        end if
}

macro MK_IMMD P2,P3,P4,P5
{
        _IMMDCNT = 3
        irp _PARM, P2,P3,P4,P5 \{
         if (_IMMDCNT) = 0
          IF _SIZE = 1
            DB     _PARM
          ELSE
            DW     _PARM
          end if
         ELSE
          if (_IMMDCNT-1) = 0
           IF _SIZE = 4
            match any$, _PARM \\{
            DW     _PARM
            \\}
            match , _PARM \\{
            DW     0H
            \\}
           end if
          end if
         end if
         _IMMDCNT = _IMMDCNT + 1
         match =IMMD, _PARM \\{
         _IMMDCNT = 0
         \\}
        \}
}

macro F_BREG TBREG
{
        _BREGNUM = 0
         irp TREG, BH,DH,CH,AH,BL,DL,CL,AL \{
          define idn$indeins14 idn$no
          match =TREG, TBREG \\{ define idn$indeins14 idn$yes \\}
          match =idn$yes, idn$indeins14 \\{
            _BREGNUM = 0
          \\}
          match =idn$no, idn$indeins14 \\{
            _BREGNUM = _BREGNUM + 1
          \\}
         \}
         if ~ (_BREGNUM < 8)
          irp TREG, BH,DH,CH,AH,BL,DL,CL,AL \{
           define idn$indeins15 idn$no
           match =TREG, TDREG \\{ define idn$indeins15 idn$yes \\}
           match =idn$yes, idn$indeins15 \\{
             _BREGNUM = 0
           \\}
           match =idn$no, idn$indeins15 \\{
             _BREGNUM = _BREGNUM + 1
           \\}
          \}
         end if
}

macro F_WREG TWREG
{
        _WREGNUM = 0
         irp TREG, DI,SI,BP,SP,BX,DX,CX,AX \{
          define idn$indeins16 idn$no
          match =TREG, TWREG \\{ define idn$indeins16 idn$yes \\}
          match =idn$yes, idn$indeins16 \\{
            _WREGNUM = 0
          \\}
          match =idn$no, idn$indeins16 \\{
            _WREGNUM = _WREGNUM + 1
          \\}
         \}
         if ~ (_WREGNUM < 8)
          irp TREG, DI,SI,BP,SP,BX,DX,CX,AX \{
           define idn$indeins17 idn$no
           match =TREG, TWREG \\{ define idn$indeins17 idn$yes \\}
           match =idn$yes, idn$indeins17 \\{
             _WREGNUM = 0
           \\}
           match =idn$no, idn$indeins17 \\{
             _WREGNUM = _WREGNUM + 1
           \\}
          \}
         end if
}

macro F_DREG TDREG
{
        _DREGNUM = 0
         irp TREG, EDI,ESI,EBP,ESP,EBX,EDX,ECX,EAX \{
          define idn$indeins18 idn$no
          match =TREG, TDREG \\{ define idn$indeins18 idn$yes \\}
          match =idn$yes, idn$indeins18 \\{
            _DREGNUM = 0
          \\}
          match =idn$no, idn$indeins18 \\{
            _DREGNUM = _DREGNUM + 1
          \\}
         \}
         if ~ (_DREGNUM < 8)
          irp TREG, EDI,ESI,EBP,ESP,EBX,EDX,ECX,EAX \{
           define idn$indeins19 idn$no
           match =TREG, TDREG \\{ define idn$indeins19 idn$yes \\}
           match =idn$yes, idn$indeins19 \\{
             _DREGNUM = 0
           \\}
           match =idn$no, idn$indeins19 \\{
             _DREGNUM = _DREGNUM + 1
           \\}
          \}
         end if
}

macro F_BASE TBASE
{
        _BASE = 0
;;                      7     6     5     4     3     2     1     0
        irp TREG, [EDI],[ESI],[EBP],[ESP],[EBX],[EDX],[ECX],[EAX] \{
         define idn$indeins20 idn$no
         match =TREG, TBASE \\{ define idn$indeins20 idn$yes \\}
         match =idn$yes, idn$indeins20 \\{
          _BASE = 0
         \\}
         match =idn$no, idn$indeins20 \\{
          _BASE = _BASE + 1
         \\}
        \}
        if ~ (_BASE < 8)
;;                      7     6     5     4     3     2     1     0
         irp TREG, [EDI],[ESI],[EBP],[ESP],[EBX],[EDX],[ECX],[EAX] \{
          define idn$indeins21 idn$no
          match =TREG, TBASE \\{ define idn$indeins21 idn$yes \\}
          match =idn$yes, idn$indeins21 \\{
           _BASE = 0
          \\}
          match =idn$no, idn$indeins21 \\{
           _BASE = _BASE + 1
          \\}
         \}
        end if
}

macro F_INDEX INDX
{
        _INDEX = 0
;;                      7    6    5    4    3    2    1    0
        irp TREG, [EDI,[ESI,[EBP,_XX_,[EBX,[EDX,[ECX,[EAX \{
         define idn$indeins22 idn$no
         match =TREG, INDX \\{ define idn$indeins22 idn$yes \\}
         match =idn$yes, idn$indeins22 \\{
          _INDEX = 0
         \\}
         match =idn$no, idn$indeins22 \\{
          _INDEX = _INDEX + 1
         \\}
        \}
        if ~ (_INDEX < 8)
;;                       7    6    5    4    3    2    1    0
         irp TREG, [EDI,[ESI,[EBP,_XX_,[EBX,[EDX,[ECX,[EAX \{
          define idn$indeins23 idn$no
          match =TREG, INDX \\{ define idn$indeins23 idn$yes \\}
          match =idn$yes, idn$indeins23 \\{
           _INDEX = 0
          \\}
          match =idn$no, idn$indeins23 \\{
           _INDEX = _INDEX + 1
          \\}
         \}
        end if
}

macro F_SCALE TSCALE
{
        _SCALE = 0
;;                     3    2    1    0
        irp TREG, *8], *4], *2], *1] \{
         define idn$indeins24 idn$no
         match =TREG, TSCALE \\{ define idn$indeins24 idn$yes \\}
         match =idn$yes, idn$indeins24 \\{
          _SCALE = 0
         \\}
         match =idn$no, idn$indeins24 \\{
          _SCALE = _SCALE + 1
         \\}
        \}
}

PAGE

; Macros to PUSH and POP the new segment registers FS and GS


; PUSH_FS - PUSH FS segment register

macro PUSH_FS 
{
          DB    00FH
          DB    0A0H
}


; PUSH_GS - PUSH GS segment register

macro PUSH_GS 
{
          DB    00FH
          DB    0A8H
}


; POP_FS - POP FS segment register

macro POP_FS 
{
          DB    00FH
          DB    0A1H
}


; POP_GS - POP GS segment register

macro POP_GS 
{
          DB    00FH
          DB    0A9H
}

PAGE

; Macros for multiplication instructions

; RIMUL - Uncharacterized Signed Multiply (16-bit)
; Syntax: RIMUL   REG,REG/MEM

macro RIMUL REG,OPND
{
        local   L1,L2
        _2BYTEOP = 1
        DB      0FH
        .XLIST
label L1 byte
        .LIST
        CMP    REG,OPND
        .XLIST
label L2 byte
        ORG    L1
        .LIST
        DB     0AFH
        .XLIST
        ORG    L2
        .LIST
}

; ERIMUL - 32 bit Uncharacterized Signed Multiply
; Systax: ERIMUL  REG,REG/MEM

macro ERIMUL REG,OPND
{
        DB      66H
        RIMUL   REG,<OPND>
}

PAGE

; Macros to load pointers with the segment in FS, GS or SS.  That is, these are
; just like the instructions LDS and LES but for the FS, GS and SS registers.

macro NEWLS OP,REG,OPND
{
        local   L1,L2
         DB      0FH
        .XLIST
label L1 byte
        .LIST
         LDS     REG,dword [OPND]
        .XLIST
label L2 byte
        ORG     L1
        .LIST
         DB      OP
        .XLIST
        ORG     L2
        .LIST
}

;       LFS     REG,OPND

macro LFS REG,OPND
{
        NEWLS   0B4H,REG,<OPND>
}

;       LGS     REG,OPND

macro LGS REG,OPND
{
        NEWLS   0B5H,REG,<OPND>
}

;       LSS     REG,OPND

macro LSS REG,OPND
{
        NEWLS   0B2H,REG,<OPND>
}

; Now we do 32 bit versions of the above

;       ELFS    REG,OPND

macro ELFS REG,OPND
{
         DB      66H
        NEWLS   0B4H,REG,<OPND>
}

;       ELGS    REG,OPND

macro ELGS REG,OPND
{
         DB      66H
        NEWLS   0B5H,REG,<OPND>
}

;       ELSS    REG,OPND

macro ELSS REG,OPND
{
         DB      66H
        NEWLS   0B2H,REG,<OPND>
}

PAGE

; Macros for some shift instructions

; Shift Left Double     R/M, Reg [CL = COUNT] [16-bit Operand]
;       SHLD    OPND,REG      (Double left shift) [CL = COUNT]

macro SHLD OPND,REG
{
        SHDOP   0A5H,<OPND>,REG
}


; Shift Right Double    R/M, Reg [CL = COUNT] [16-bit Operand]
;       SHRD    OPND,REG      (Double right shift) [CL = COUNT]

macro SHRD OPND,REG
{
        SHDOP   0ADH,<OPND>,REG
}


; Shift Left Double     R/M, Reg, Immd (8-bit) [16-bit Operand]
;       SHLDI   OPND,REG,IMMD-8

macro SHLDI OPND,REG,IMMD
{
        SHDOP   0A4H,<OPND>,REG
        DB      IMMD
}


; Shift Right Double    R/M, Reg, Immd (8-bit) [16-bit Operand]
;       SHRDI   OPND,REG,IMMD-8

macro SHRDI OPND,REG,IMMD
{
        SHDOP   0ACH,<OPND>,REG
        DB      IMMD
}

; Now 32 bit versions of the above

; Shift Left Double     R/M, Reg [CL = COUNT]  [32-bit Operand]
;       ESHLD   OPND,REG        (Double left shift) [CL = COUNT]

macro ESHLD OPND,REG
{
         DB      66H
        SHDOP   0A5H,<OPND>,REG
}


; Shift Right Double    R/M, Reg [CL = COUNT]  [32-bit Operand]
;       ESHRD   OPND,REG        (Double right shift) [CL = COUNT]

macro ESHRD OPND,REG
{
         DB      66H
        SHDOP   0ADH,<OPND>,REG
}


; Shift Left Double     R/M, Reg, Immd (8-bit) [32-bit Operand]
;       ESHLDI  OPND,REG,IMMD-8 (Double left shift)

macro ESHLDI OPND,REG,IMMD
{
         DB      66H
        SHDOP   0A4H,<OPND>,REG
         DB      IMMD
}


; Shift Right Double    R/M, Reg, Immd (8-bit) [32-bit Operand]
;      ESHRDI  OPND,REG,IMMD-8 (Double right shift)

macro ESHRDI OPND,REG,IMMD
{
         DB      66H
        SHDOP   0ACH,<OPND>,REG
         DB      IMMD
}


macro SHDOP OP,OPND,REG
{
        local   L1,L2
        _2BYTEOP = 1
         DB      0FH
        .XLIST
label L1 byte
        .LIST
         OR      REG,OPND
        .XLIST
label L2 byte
        ORG     L1
        .LIST
         DB      OP
        .XLIST
        ORG     L2
        .LIST
}

PAGE

;       The following two instructions, CALLFAR and JUMPFAR, work in the
;       MS Macro Assembler, but not for intersegment direct.  The assembler
;       generates segments based on 8088 values, and we need them based
;       on protect-mode selector values.  The assembler works just ducky for
;       jump and call far indirect, since you go pick up the offset and
;       segment at execution time.

macro CALLFAR DISP,SEGMENT
{

        DB      09AH                    ; Call far direct
        DW      (DISP)                 ;   to this offset
;        DW      SEGMENT                ;     in this segment

}


macro JUMPFAR DISP,SEGMENT
{

        DB      0EAH                    ; Jump far direct
        DW      (DISP)                 ;   to this offset
;        DW      SEGMENT                ;     in this segment

}

PAGE

; Macros for extended jump instructions

macro LJCOND OP,DISPL
{
        _2BYTEOP = 1
TEMP    =       $ + 4
         DB      0FH
         DB      OP
         DW      (DISPL)-(TEMP)
}

;       LJO     DISPL  (Long Jump on Overflow)
macro LJO DISPL
{
        LJCOND  80H,<DISPL>
}


;       LJNO    DISPL  (Long Jump on NO Overflow)
macro LJNO DISPL
{
        LJCOND  81H,<DISPL>
}

